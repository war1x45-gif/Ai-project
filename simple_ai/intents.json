    },
    {
      "tag": "joke",
      "patterns": ["tell me a joke", "make me laugh", "say something funny", "do you know any jokes", "joke please", "i want a joke"],
      "responses": [
        "Why did the neural network break up with the dataset? It found too many outliers.",
        "I would tell you a UDP joke, but you might not get it.",
        "There are 10 kinds of people: those who understand binary and those who don't."
      ]
    },
    {
      "tag": "how_it_works",
      "patterns": ["how do you work", "how were you made", "are you a real ai", "what algorithm do you use", "how do you understand me", "explain how you think"],
      "responses": ["I use a Naive Bayes classifier: I split your message into words, then pick the intent whose training examples make those words most likely."]
    }
  ]
