{
  "intents": [
    {
      "tag": "greeting",
      "patterns": ["hi", "hello", "hey", "good morning", "good evening", "hey there", "hello there", "hi bot", "yo", "howdy"],
      "responses": ["Hello! How can I help you?", "Hi there!", "Hey! What can I do for you?"]
    },
    {
      "tag": "goodbye",
      "patterns": ["bye", "goodbye", "see you later", "see you", "farewell", "catch you later", "i am leaving", "have a good day", "talk to you later"],
      "responses": ["Goodbye!", "See you later!", "Have a great day!"]
    },
    {
      "tag": "thanks",
      "patterns": ["thanks", "thank you", "thanks a lot", "much appreciated", "thank you so much", "that was helpful", "cheers"],
      "responses": ["You're welcome!", "Happy to help!", "Any time!"]
    },
    {
      "tag": "name",
      "patterns": ["what is your name", "who are you", "what are you called", "tell me your name", "what should i call you", "introduce yourself"],
